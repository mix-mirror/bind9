options {
{% include "_common/options-dual.conf.j2" %}
	allow-recursion { any; };
	dnssec-validation no;
	deny-answer-aliases {
		"example";
	} except-from {
		"example";
	};
	qname-minimization disabled;  // Regression test for GL #4652
};


key restart16 {
	secret "1234abcd8765";
	algorithm @DEFAULT_HMAC@;
};

{% include "_common/controls.conf.j2" %}

view restart16 {
	match-clients { key restart16; none; };
	max-query-restarts 16;

{% filter indent("	", true) %}
{% include "_common/root.hint.conf" %}
{% endfilter %}
};

view default {
{% filter indent("	", true) %}
{% include "_common/root.hint.conf" %}
{% endfilter %}
};
