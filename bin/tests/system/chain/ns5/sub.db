$TTL 300	; 5 minutes
@			IN SOA	mname1. . (
				2017031001 ; serial
				20         ; refresh (20 seconds)
				20         ; retry (20 seconds)
				1814400    ; expire (3 weeks)
				3600       ; minimum (1 hour)
				)
			NS	ns5
ns5			A	10.53.0.5

a			A	10.0.0.1
b			A	10.0.0.2
c			A	10.0.0.3
d			A	10.0.0.4

; see the xloop comment in ns2/example.db
xloop1			CNAME	xloop2.example.
xloop3			CNAME	xloop4.example.
xloop5			CNAME	xloop6.example.
xloop7			CNAME	xloop8.example.
xloop9			CNAME	xloop10.example.
xloop11			CNAME	xloop12.example.
xloop13			CNAME	xloop14.example.
xloop15			CNAME	xloop16.example.
xloop17			CNAME	xloop0.example.
