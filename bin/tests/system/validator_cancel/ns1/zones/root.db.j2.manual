$TTL 300
.			IN SOA	. a.root.servers.nil. (
				2000042100	; serial
				600		; refresh
				600		; retry
				1200		; expire
				600		; minimum
)

.			NS	a.root-servers.nil.
a.root-servers.nil.	A	10.53.0.1

hoster1.		NS	ns.hoster1.
ns.hoster1.		A	10.53.0.2

hoster2.		NS	ns.hoster2.
ns.hoster2.		A	10.53.0.4

tld.			NS	ns-tld.hoster1.
tld.			NS	ns-tld.hoster2.
