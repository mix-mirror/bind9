{% set ns3ttl = ns3ttl | default(555) %}
{% set ns3ip = ns3ip | default("10.53.33.33") %}
{% set extrarr = extrarr | default(False) %}

$TTL 300	; 5 minutes
ghost.example.		IN SOA	mname1. . (
				2000042407 ; serial
				20	   ; refresh (20 seconds)
				20	   ; retry (20 seconds)
				1814400	   ; expire (3 weeks)
				3600	   ; minimum (1 hour)
				)
; delegation is different in the child with a TTL of 300.
			NS	ns3

; ns3 is different in the child with a TTL of 300.
ns3			A	10.53.0.3	

bar			A	10.53.0.44
baz			A	10.53.0.45
