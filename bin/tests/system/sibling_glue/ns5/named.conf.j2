/* Resolver talking to the "tld" server over TCP without DNS COOKIE. */

options {
	query-source address 10.53.0.5;
	notify-source 10.53.0.5;
	transfer-source 10.53.0.5;
	port @PORT@;
	pid-file "named.pid";
	listen-on { 10.53.0.5; };
	recursion yes;
	dnssec-validation no;
	qname-minimization off;
};

server 10.53.0.2 {
	tcp-only yes;
	send-cookie no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "../../_common/root.hint";
};
