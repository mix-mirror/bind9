options {
	query-source address 10.53.0.3;
	notify-source 10.53.0.3;
	transfer-source 10.53.0.3;
	port @PORT@;
	pid-file "named.pid";
	listen-on { 10.53.0.3; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "foo.tld" {
	type primary;
	file "foo.tld.db";
};

zone "bar.tld" {
	type primary;
	file "bar.tld.db";
};
