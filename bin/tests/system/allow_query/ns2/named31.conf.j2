key one {
	algorithm @DEFAULT_HMAC@;
	secret "1234abcd8765";
};

key two {
	algorithm @DEFAULT_HMAC@;
	secret "1234efgh8765";
};


options {
{% include "_common/options.conf.j2" %}
	recursion no;
	allow-query { key one; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

view "internal" {

	allow-query { key one; };

