/*
 * This is just a random selection of configuration options.
 */

/* cut here */
dnssec-policy "test" {
	cdnskey yes;
	cds-digest-types {
		"sha-256";
	};
	dnskey-ttl 3600;
	keys {
		ksk key-directory lifetime P1Y algorithm 13 tag-range 0 32767;
		zsk lifetime P30D algorithm 13;
		csk key-store "hsm" lifetime P30D algorithm 8 2048;
	};
	manual-mode no;
	max-zone-ttl 86400;
	nsec3param ;
	parent-ds-ttl 7200;
	parent-propagation-delay PT1H;
	publish-safety PT3600S;
	purge-keys P90D;
	retire-safety PT3600S;
	signatures-jitter PT12H;
	signatures-refresh P3D;
	signatures-validity P2W;
	signatures-validity-dnskey P14D;
	zone-propagation-delay PT5M;
};
dyndb "name" "library.so" {
	this;
	\};
	is a {
		"test" { \{ of; the; };
	} bracketed;
	"text \"";
	system;
};
key "mykey" {
	algorithm "@DEFAULT_HMAC@";
	secret "qwertyuiopasdfgh";
};
key-store "hsm" {
	directory ".";
	pkcs11-uri "pkcs11:token=bind9;pin-value=1234";
};
options {
	blackhole {
		10.0.0.0/8;
	};
	check-names primary warn;
	check-names secondary ignore;
	directory ".";
	dnssec-policy "test";
	dump-file "named_dumpdb";
	hostname none;
	interface-interval 30;
	listen-on port 90 {
		"any";
	};
	listen-on port 100 {
		127.0.0.1/32;
	};
	listen-on-v6 port 53 {
		"none";
	};
	match-mapped-addresses yes;
	max-cache-size 20000000000000;
	max-ixfr-ratio 90%;
	max-query-count 100;
	max-query-restarts 10;
	memstatistics-file "named.memstats";
	nta-lifetime 604800;
	nta-recheck 604800;
	pid-file none;
	port 5300;
	querylog yes;
	recursing-file "named.recursing";
	recursive-clients 3000;
	serial-query-rate 100;
	server-id none;
	transfer-source 0.0.0.0;
	update-quota 200;
	validate-except {
		"corp";
	};
	zone-statistics none;
};
remote-servers "parents" port 5353 source 10.10.10.10 source-v6 2001:db8::10 {
	10.10.10.11;
	2001:db8::11;
};
view "first" {
	dnssec-validation auto;
	match-clients {
		"none";
	};
	max-query-restarts 15;
	zone-statistics terse;
	zone "example1" {
		type primary;
		file "xxx";
		max-ixfr-ratio 20%;
		notify-source 10.10.10.10;
		update-policy local;
	};
	zone "clone" {
		type primary;
		file "yyy";
		max-ixfr-ratio unlimited;
	};
	zone "reports" {
		type primary;
		file "reports";
		log-report-channel yes;
	};
};
view "second" {
	dnssec-validation auto;
	match-clients {
		"any";
	};
	zone-statistics full;
	zone "example1" {
		type primary;
		file "zzz";
		update-policy local;
		zone-statistics yes;
	};
	zone "example2" {
		type static-stub;
		forward only;
		forwarders tls "ephemeral" {
			10.53.0.4 port 8053 tls "ephemeral";
		};
		zone-statistics no;
	};
	zone "example3" {
		type static-stub;
		server-addresses {
			1.2.3.4;
		};
	};
	zone "clone" {
		in-view "first";
	};
	zone "." {
		type redirect;
		primaries {
			1.2.3.4;
		};
	};
};
view "third" {
	match-clients {
		"none";
	};
	zone "clone" {
		forward only;
		forwarders {
			10.0.0.100;
		};
		in-view "first";
	};
	zone "dnssec" {
		type primary;
		file "file";
		allow-update {
			"any";
		};
		dnssec-policy "default";
	};
	zone "p" {
		type primary;
		file "pfile";
	};
	zone "s" {
		type secondary;
		file "sfile";
		notify primary-only;
		primaries {
			1.2.3.4;
		};
	};
};
view "fourth" {
	dnssec-policy "default";
	key-directory ".";
	zone "dnssec-test" {
		type primary;
		file "dnssec-test.db";
		checkds explicit;
		dnssec-policy "test";
		notify-cfg "SOA" {
			notify yes;
			notify-defer 1;
			notify-delay 3;
			notify-source 192.0.2.1;
			notify-source-v6 2001:db8::1;
		};
		notify-cfg "CDS" {
			notify no;
		};
		parental-agents {
			1.2.3.4;
			1.2.3.5;
		};
		parental-source 10.10.10.10;
	};
	zone "dnssec-default" {
		type primary;
		file "dnssec-default.db";
		dnssec-policy "default";
		notify-cfg "CDS" {
			notify yes;
			notify-defer 0;
			notify-delay 5;
			notify-source 0.0.0.0;
			notify-source-v6 ::;
		};
		parental-agents {
			"parents";
		};
	};
	zone "dnssec-inherit" {
		type primary;
		file "dnssec-inherit.db";
		checkds no;
	};
	zone "dnssec-none" {
		type primary;
		file "dnssec-none.db";
		dnssec-policy "none";
	};
	zone "dnssec-view1" {
		type primary;
		file "dnssec-view41.db";
		checkds yes;
		dnssec-policy "test";
	};
	zone "dnssec-view2" {
		type primary;
		file "dnssec-view42.db";
	};
	zone "dnssec-view3" {
		type primary;
		file "dnssec-view43.db";
		dnssec-policy "none";
		key-directory "keys";
	};
	zone "dnssec-view4" {
		type primary;
		file "dnssec-view44.db";
		dnssec-policy "none";
	};
};
view "fifth" {
	key-directory ".";
	zone "dnssec-view1" {
		type primary;
		file "dnssec-view51.db";
		dnssec-policy "test";
	};
	zone "dnssec-view2" {
		type primary;
		file "dnssec-view52.db";
		dnssec-policy "test";
		key-directory "keys";
	};
	zone "dnssec-view3" {
		type primary;
		file "dnssec-view53.db";
		dnssec-policy "default";
		key-directory "keys";
	};
	zone "dnssec-view4" {
		type primary;
		file "dnssec-view54.db";
		dnssec-policy "none";
	};
};
view "chaos" chaos {
	zone "hostname.bind" chaos {
		type primary;
		database "_builtin hostname";
	};
};
