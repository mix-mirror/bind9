options {
	{% include_indented "_common/options.conf.j2" %}
	session-keyfile "session.key";
	recursion no;
	minimal-responses no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "local.nil" {
	type primary;
	file "local.db";
	update-policy local;
};

zone "zonemd.test" {
	type secondary;
	primaries { 10.53.0.3; };
	file "zonemd.test.bk";
};

zone "zonemd-nsec3.test" {
	type secondary;
	primaries { 10.53.0.3; };
	file "zonemd-nsec3.test.bk";
};
