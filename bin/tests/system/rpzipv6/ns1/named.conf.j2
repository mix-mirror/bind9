// NS1 is the authoritative server for the "lab" zone whose AAAA targets the
// resolver (ns2) tries to filter with RPZ IP triggers.

key rndc_key {
	secret "1234abcd8765";
	algorithm @DEFAULT_HMAC@;
};

controls {
	inet 10.53.0.1 port @CONTROLPORT@ allow { any; } keys { rndc_key; };
};

options {
	query-source address 10.53.0.1;
	notify-source 10.53.0.1;
	transfer-source 10.53.0.1;
	port @PORT@;
	listen-on { 10.53.0.1; };
	listen-on-v6 { none; };
	pid-file "named.pid";
	notify no;
	recursion no;
	dnssec-validation no;
};

zone "lab" {
	type primary;
	file "lab.db";
	allow-transfer { none; };
};
