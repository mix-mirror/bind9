$TTL 300
@		IN SOA	ns1.lab. hostmaster.lab. ( 1 3600 1200 604800 60 )
@		IN NS	ns1.lab.
ns1.lab.	IN A	10.53.0.1

; AAAA targets matched by the RPZ rpz-ip triggers in ns2/rpz.db.  Each address
; has exactly one isolated zero 16-bit group except the "double-zero" control,
; which has a length-2 zero run.
single-zero	IN AAAA	2001:db8:1:0:1:1:1:1
trailing-zero	IN AAAA	2001:db8:1:1:1:1:1:0
double-zero	IN AAAA	2001:db8:0:0:1:1:1:1
