$TTL 300	; 5 minutes
@			IN SOA	mname1. . (
				2000042407 ; serial
				20	   ; refresh (20 seconds)
				20	   ; retry (20 seconds)
				1814400	   ; expire (3 weeks)
				3600	   ; minimum (1 hour)
				)
			NS	a.root-servers.nil.
a.root-servers.nil.	A	10.53.0.1

; A DELEG-delegated subdomain
delegonly		DELEG	server-ipv4=10.53.0.2

; A subdomain delegated with both NS and DELEG
mixed			DELEG	server-ipv4=10.53.0.2
mixed			NS	ns2.mixed
ns2.mixed		A	10.53.0.2

; A DELEG-delegated subdomain using a two names, only the second actually
; resolve into something
delegname		DELEG	server-name=ns.foo,a.delegonly

;; A DELEG-delegated subdomain using multiples IPs, but one of them won't give 
delegips		DELEG 	server-ipv4=10.53.0.44,10.53.0.55 server-ipv6=fd92:7065:b8e:ff::acdc,fd92:7065:b8e:ff::3,fd92:7065:b8e:ff::cafe,fd92:7065:b8e:ff::dead:beef

delegmandatory		DELEG	mandatory=server-ipv4,server-ipv6 server-ipv4=10.53.0.3 server-ipv6=fd92:7065:b8e:ff::acdc,fd92:7065:b8e:ff::3
