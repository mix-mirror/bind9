# Assertion conditions must not have side effects (doc/dev/dev.md#dbc).
# Used by the 'assert-side-effect' test in the 'clang-tidy' meson suite.
Checks: '-*,bugprone-assert-side-effect'
WarningsAsErrors: '*'
CheckOptions:
  bugprone-assert-side-effect.AssertMacros: 'REQUIRE,ENSURE,INSIST,INVARIANT'
  bugprone-assert-side-effect.CheckFunctionCalls: false
