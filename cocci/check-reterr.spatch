@@
expression E1;
symbol result, cleanup;
@@

- result = E1;
- if (result != ISC_R_SUCCESS) {
- goto cleanup;
- }
+ CHECK(E1);

@@
expression E1;
isc_result_t R;
@@

- R = E1;
- if (R != ISC_R_SUCCESS) {
- return R;
- }
+ RETERR(E1);

@@
expression E1;
symbol result;
@@

- result = E1;
- if (result != ISC_R_SUCCESS) {
- CHECK(result);
- }
+ CHECK(E1);
