@@
symbol result;
symbol cleanup;
expression E1;
@@

- result = E1;
- if (result != ISC_R_SUCCESS) {
- goto cleanup;
- }
+ CHECK(E1);

@@
isc_result_t res;
expression E1;
@@

- res = E1;
- if (res != ISC_R_SUCCESS) {
- return res;
- }
+ RETERR(E1);

@@
symbol result;
expression E1;
@@

- result = E1;
- if (result != ISC_R_SUCCESS) {
- CHECK(result);
- }
+ CHECK(E1);
